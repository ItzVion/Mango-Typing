{
  "installCommand": "npm install --prefix server --legacy-peer-deps && npm install --prefix client && cd server && npx prisma generate",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": { "includeFiles": "server/prisma/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}