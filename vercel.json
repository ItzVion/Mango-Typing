{
  "installCommand": "npm install --prefix server && npm install --prefix client && npx --prefix server prisma generate",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": { "includeFiles": "server/prisma/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}