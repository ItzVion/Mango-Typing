datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id                     String       @id @default(uuid())
  email                  String       @unique
  username               String       @unique
  passwordHash           String?
  googleId               String?      @unique
  avatarUrl              String?
  role                   String       @default("USER")
  hasDonated             Boolean      @default(false)
  sessionVersion         Int          @default(0)
  termsAcceptedVersion   String?
  privacyAcceptedVersion String?
  refundAcceptedVersion  String?
  legalAcceptedAt        DateTime?
  createdAt              DateTime     @default(now())

  tests                  TypingTest[]
  donations              Donation[]
  privacyRequests        PrivacyRequest[]
  auditLogs              AuditLog[]
}

model Sheet {
  id         Int          @id @default(autoincrement())
  title      String
  topic      String
  content    String
  wordCount  Int
  charCount  Int
  difficulty String       @default("easy")
  createdAt  DateTime     @default(now())

  tests      TypingTest[]
}

model TypingTest {
  id          String   @id @default(uuid())
  userId      String?
  sheetId     Int
  mode        String   @default("paper")
  wpm         Float
  rawWpm      Float
  accuracy    Float
  errors      Int
  durationSec Int
  secondStats String
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheet       Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Settings {
  id                    Int      @id @default(1)
  razorpayKeyId         String?
  razorpayKeySecret     String?
  donationMessage       String   @default("Every rupee helps keep the servers running, the domains renewed, and new features shipping. Thank you for supporting VC Typing!")
  maintenanceMode       Boolean  @default(false)
  supportEmail          String   @default("vctyping.11@gmail.com")
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean?
  smtpUser              String?
  smtpPass              String?
  smtpFrom              String?
  smtpFromName          String?
  updatedAt             DateTime @updatedAt
}

model Donation {
  id                String   @id @default(uuid())
  userId            String?
  amountRupees      Int
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  status            String   @default("created")
  createdAt         DateTime @default(now())

  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model LegalPage {
  slug      String   @id
  content   String
  version   String   @default("2026-09-10")
  updatedAt DateTime @updatedAt
}

model OtpToken {
  email        String   @id
  token        String
  expiresAt    DateTime
  username     String
  passwordHash String
  legalVersion String?
  attempts     Int      @default(0)
  lastSentAt   DateTime @default(now())
}

model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model VerificationCode {
  id          String   @id @default(uuid())
  userId      String
  purpose     String
  token       String
  targetEmail String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  attempts    Int      @default(0)

  @@index([userId, purpose])
}

model RazorpayWebhookEvent {
  eventId    String   @id
  eventType  String
  receivedAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model PrivacyRequest {
  id          String   @id @default(uuid())
  userId      String
  type        String
  status      String   @default("OPEN")
  details     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
